PORT=5001
# Keep 5001 locally; the CRA frontend proxies to http://localhost:5001 (see frontend/package.json).

# Firebase project ID (same value as REACT_APP_FIREBASE_PROJECT_ID in the frontend).
# Used to verify the sign-in tokens the frontend sends; no service account key is needed.
FIREBASE_PROJECT_ID=

# Production frontend URL, if it isn't on *.vercel.app (optional)
# FRONTEND_URL=https://your-domain.com

# AI assistant (Google Gemini). Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default in code is gemini-2.5-flash. If you see "free_tier ... limit: 0", link billing on the GCP project
# or try: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash-lite (see https://ai.google.dev/gemini-api/docs/models )
GEMINI_MODEL=gemini-2.5-flash
